# Runtime
APP_MODE=demo
NEXT_PUBLIC_APP_NAME="Tun Conversation Engine"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required when APP_MODE=live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional in demo; required for live AI classification/drafting)
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_DRAFT_MODEL=gpt-5.6-terra

# Syften (required for live ingestion)
SYFTEN_API_TOKEN=
SYFTEN_API_BASE_URL=https://syften.com

# Server-to-server protection for cron/manual ingestion endpoints
CRON_SECRET=

# Reddit publishing - keep disabled until Reddit approval is complete.
# Preferred path is Devvit / approved Reddit tooling. The app should only publish after an explicit reviewer action.
REDDIT_PUBLISHING_ENABLED=false
REDDIT_PUBLISHING_MODE=devvit
REDDIT_DEVVIT_APP_SLUG=

# Legacy/alternate OAuth placeholders, only if Reddit approves that route instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=TunConversationEngine/0.2
