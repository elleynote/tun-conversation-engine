# Runtime
APP_MODE=demo
NEXT_PUBLIC_APP_NAME="Tun Conversation Engine"
NEXT_PUBLIC_SITE_URL=https://scousi.com

# Supabase (required when APP_MODE=live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for live AI classification/drafting)
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_DRAFT_MODEL=gpt-5.6-terra

# Syften (required for live ingestion)
SYFTEN_API_TOKEN=
SYFTEN_API_BASE_URL=https://syften.com

# Server-to-server protection for cron/manual ingestion endpoints
CRON_SECRET=

# Reddit API publishing is intentionally disabled for launch.
# Approved workflow: approve -> copy reply -> open Reddit -> post manually -> mark as posted.
REDDIT_PUBLISHING_ENABLED=false
REDDIT_PUBLISHING_MODE=manual
REDDIT_DEVVIT_APP_SLUG=

# Keep empty unless Reddit later approves another publishing route.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=TunConversationEngine/0.3
