{
  "manifest_version": 3,
  "name": "Tun Conversation Engine Auto-Poster",
  "version": "1.3.0",
  "description": "Automated Reddit, X (Twitter), Facebook, Instagram, and LinkedIn comment publisher for Tun Conversation Engine",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.netlify.app/*",
    "https://*.scousi.com/*",
    "https://*.reddit.com/*",
    "https://reddit.com/*",
    "https://*.x.com/*",
    "https://x.com/*",
    "https://*.twitter.com/*",
    "https://twitter.com/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://*.instagram.com/*",
    "https://instagram.com/*",
    "https://*.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.netlify.app/*",
        "https://*.scousi.com/*"
      ],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": ["reddit-poster.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.x.com/*",
        "https://x.com/*",
        "https://*.twitter.com/*",
        "https://twitter.com/*"
      ],
      "js": ["x-poster.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["facebook-poster.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["instagram-poster.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["linkedin-poster.js"],
      "run_at": "document_idle"
    }
  ]
}
